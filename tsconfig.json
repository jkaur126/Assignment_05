{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "./",
    "paths": {
      "*": ["*"]
    },
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "alwaysStrict": true
  },
  "include": [
    "src/**/*",
    "config/**/*",
    "tests/**/*",
    "jest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "ts-node": {
    "files": true,
    "require": ["dotenv/config"]
  }
}

